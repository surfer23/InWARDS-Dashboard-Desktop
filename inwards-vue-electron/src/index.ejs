<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>INWARDS</title>
  <script>
    // Polyfill for global (needed by some libraries)
    window.global = window;
  </script>
</head>

<body class="dark-mode">
  <div id="app"></div>
  <!-- Set `__static` path to static files in production -->
  <% if (!htmlWebpackPlugin.options.isDevelopment) { %>
  <script>
    // In production, __static is set relative to the HTML file
    window.__static = './static';
  </script>
  <% } %>

  <script>
    // See https://github.com/facebook/react/issues/20829#issuecomment-802088260
    // SharedArrayBuffer polyfill for sql.js WASM
    if (!crossOriginIsolated && typeof SharedArrayBuffer === 'undefined') {
      window.SharedArrayBuffer = ArrayBuffer;
    }
  </script>
  <!-- webpack builds are automatically injected -->
</body>

</html>
